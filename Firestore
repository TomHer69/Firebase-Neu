async function lesen() {
    const docRef = doc(db, "users", "2425");
    const docSnap = await getDoc(docRef);

    if (docSnap.exists()) {
        console.table(Object.keys(docSnap.data()));//Alle Feld namen

        console.log("Daten:", docSnap.data());
        console.log("Name:", docSnap.data().name);
    } else {
        console.log("Dokument nicht gefunden");
    }
}


