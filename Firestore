async function leseBenutzerAusBerlin() {
    const q = query(
        collection(db, "users"),
        where("stadt", "==", "Berlin")
    );

    const querySnapshot = await getDocs(q);

    querySnapshot.forEach((doc) => {
        console.log(doc.id, "=>", doc.data());
    });
}






