export async function speichen() {
    console.log("speichen");
    try {
        const docRef = await addDoc(collection(db, "users"), {
            name: "Thomas",
            alter: 30,
            stadt: "Berlin",
            erstelltAm: new Date()
        });

        console.log("Dokument gespeichert mit ID:", docRef.id);
    } catch (error) {
        console.error("Fehler beim Speichern:", error);
    }
}


